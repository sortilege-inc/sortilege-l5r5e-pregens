     "firstname": "Kunimichi"
    },
    "picks": {}
   },
   "step20": {
    "answers": {
     "death": "Kunimichi is not under any illusions. Most likely, he dies by his own hand in an accident; next most likely is that the conspiracy is betrayed and he is executed."
    },
    "picks": {}
   }
