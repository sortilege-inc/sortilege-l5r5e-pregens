# Secrets — never commit
.env

# Generated build-time store; rebuild with scripts/build.py
pipeline/l5r.sqlite

# Local python
__pycache__/
*.pyc

# Node
node_modules/

# Raw actor portraits pulled from Foundry (18 MB, re-fetchable with
# scripts/foundry_pull.py). The web-sized art lives in src/portraits/.
pipeline/foundry/portraits/

# Local-only Anthropic key for the Creator, generated from .env by scripts/build.py.
# Never publish a key with a static site.
data/ai-key.local.js

# Wrangler local state (account cache, build tmp)
worker/.wrangler/
