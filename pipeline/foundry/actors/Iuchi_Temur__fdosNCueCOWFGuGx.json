  {
   "name": "Daikyū",
   "type": "weapon",
   "flags": {},
   "img": "systems/l5r5e/assets/icons/weapons/bow.svg",
   "effects": [],
   "_stats": {
    "compendiumSource": "Compendium.l5r5e-compendia-sortilege.weapons-l5r-sortilege.Item.sjVz7tI11BkNAA7t",
    "duplicateSource": null,
    "exportSource": null,
    "coreVersion": "14.365",
    "systemId": "l5r5e",
    "systemVersion": "1.13.1",
    "createdTime": 1761628827557,
    "modifiedTime": 1761628827557,
    "lastModifiedBy": "7vKCnwOtrdD7lBip"
   },
   "system": {
    "source_reference": {
     "source": "core_rulebook",
     "page": 236
    },
    "description": "<p><span class=\"fontstyle0\">Daikyū are large composite bows designed to be fired from horseback. Conventionally around six feet long, these elegant weapons are constructed by gluing thin layers of wood, horn, leather, and sinew together. Daikyū differ from other bows in that they have an asymmetric shape. Their grip is about two-thirds of the way from the top, making the top curve longer than the bottom. This allows the bows to be fired easily from horseback in either direction. Each daikyū is made for a custom fit for a specific user.</span></p>",
    "parent_id": null,
