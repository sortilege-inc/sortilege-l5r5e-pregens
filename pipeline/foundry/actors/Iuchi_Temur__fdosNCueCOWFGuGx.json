   "_stats": {
    "compendiumSource": "Compendium.l5r5e-compendia-sortilege.weapons-l5r-sortilege.Item.S1MG4qPHEV3N8XnO",
    "duplicateSource": null,
    "exportSource": null,
    "coreVersion": "14.365",
