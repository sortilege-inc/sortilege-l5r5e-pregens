   "type": "weapon",
   "flags": {},
   "img": "systems/l5r5e/assets/icons/weapons/katana.svg",
   "effects": [],
   "_stats": {
    "compendiumSource": "Compendium.l5r5e-compendia-sortilege.weapons-l5r-sortilege.Item.S1MG4qPHEV3N8XnO",
    "duplicateSource": null,
    "exportSource": null,
    "coreVersion": "14.365",
    "systemId": "l5r5e",
    "systemVersion": "1.13.1",
    "createdTime": 1761631143207,
    "modifiedTime": 1761631143207,
    "lastModifiedBy": "7vKCnwOtrdD7lBip"
   },
   "system": {
    "source_reference": {
     "source": "core_rulebook",
     "page": 233
    },
    "description": "<p><span class=\"fontstyle0\">Whereas the katana represents a samurai’s status as a warrior, the wakizashi represents their place in Rokugan’s social order and strict caste system. The wakizashi is a small, katana-like sword usually two to three feet in length, with the same flexible blade and lethal edge. It is often made as part of a pair, with the same decorations as its matched katana. The wakizashi also fills another role: it clearly signals that its wearer is a samurai, and a person of honor who will make the ultimate sacrifice for their ideals and their master. It is the tool with which a samurai commits seppuku: ritual suicide, the last protest of an aggrieved and honorable samurai.</span></p>",
    "parent_id": null,
