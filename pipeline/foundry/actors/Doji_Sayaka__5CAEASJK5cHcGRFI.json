  {
   "name": "Like a Ghost",
   "type": "technique",
   "flags": {},
   "img": "systems/l5r5e/assets/icons/techs/ninjutsu.svg",
   "effects": [],
   "_stats": {
    "compendiumSource": "Compendium.l5r5e-compendia-sortilege.techniques-ninjitsu-l5r-sortilege.Item.a8519t9KXMAL6tBV",
    "duplicateSource": null,
