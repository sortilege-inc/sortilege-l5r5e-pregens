  {
   "name": "Truth Burns through Lies",
   "type": "technique",
   "flags": {},
   "img": "systems/l5r5e/assets/icons/techs/shuji.svg",
   "effects": [],
   "_stats": {
    "compendiumSource": "Compendium.l5r5e-compendia-sortilege.techniques-shuji-l5r-sortilege.Item.YNquxCeVzw7ekMag",
    "duplicateSource": null,
    "exportSource": null,
