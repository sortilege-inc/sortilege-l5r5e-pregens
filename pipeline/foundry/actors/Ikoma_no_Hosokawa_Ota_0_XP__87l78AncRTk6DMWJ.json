    "social_honor": 40
   },
   "step4": {
    "stand_out": "He is grounded and responds to provocations; he does not react to them. Responses are always considered, although sometimes that consideration occurs in fractions of a second.",
    "ring": "earth"
   },
   "step5": {
    "social_giri": "Ikoma Kenji sought out the Yogo monastery. He has felt cornered by his beloved brother, who refuses to recognize reality, and Kenji needs an ally who can help him overcome his aversion to conflict; and if needed, initiate that conflict."
   },
   "step6": {
    "social_ninjo": "Ota longs to be a peacemaker, but does not have the liberty to contest his lord's framing nor leave his lord's service to serve others more in keeping with his desire."
   },
   "step7": {
    "clan_relations": "Ota no longer has a relationship with the Scorpion clan; when the monastery released him into Ikoma Kenji's service, he was released fully. That doesn't mean the Scorpion won't try to reinsert themselves someday, however. But Kenji had the Hosokawa formally adopt Ota and bring him into the Lion clan legally.",
    "skill": "culture",
    "social_add_glory": 0
   },
   "step8": {
    "bushido": "Ota believes that bushido is something that must be strived for, and must be failed at.",
    "skill": "none",
    "social_add_honor": 10,
    "tenet_paramount": "Compassion",
    "tenet_less_significant": "Honor",
    "item": []
   },
   "step9": {
    "success": "Upon grieving his greatest humiliation, Ota dedicated himself to the monastic arts, and found excellence in the practice of air kiho; even though he is no longer bound to the Yogo, he knows that should he even have need, he need but ask.",
    "distinction": [
     "L5RCoreDis000040"
    ]
   },
   "step10": {
    "difficulty": "The other Hosokawa do not know who Ota was, and the reasons for adoption were made opaque to them, but they cannot help but believe there is a darkness there, and sometimes they can see that darkness in Ota's eyes.",
    "adversity": [
     "L5RCoreAdv000046"
    ]
   },
   "step11": {
    "calms": "Ota delights in selecting and preparing a gift that is a perfect match for the recipient.",
    "passion": [
     "L5RCorePas000009"
    ]
   },
   "step12": {
    "worries": "Ota remembers burying his sister alive. He tries not to. But part of him cannot shake the horror, and he refuses to allow himself to be similarly trapped.",
    "anxiety": [
     "L5RCoreAnx000027"
    ]
   },
   "step13": {
    "most_learn": "Yogo Kitohime never asked what Ota had done. Never judged him. She knew his burden intimately, like he knew hers. She focused him on the present, not the past.",
    "skill": "none",
    "advantage": [
     "L5RCoreDis000055"
    ],
    "disadvantage": []
   },
   "step14": {
    "first_sight": "The bold golden sash with fine details in red thread that is tied to Ota's yari matches the sash he wears, and is unusual for the Hosokawa.",
    "special_features": [
     "L5RCoreIte000107"
    ]
   },
   "step15": {
    "stress": "Ota refuses to be touched by others while disregulated or in physiological distress."
   },
   "step16": {
    "relations": "We discussed the Ikoma, Hosokawa and Yogo; the rest we can figure out in the story. The lion helm indicates his association with the Ikoma family.",
    "item": [
     "L5RCoreIte000084"
    ]
   },
   "step17": {
    "parents_pov": "As a child, Yogo Ota didn't get to see much theater, but what little he witnessed sparked his imagination and he and his sister made many of their own productions around their home.",
    "skill": "performance",
    "bond": []
   },
   "step18": {
    "heritage_name": "Uncle Ota was an accomplished polearm master, who was delighted to teach what he could to his young namesake. He left on his lord's business when Ota was a young teen, and never returned.",
    "heritage_1": 8,
    "heritage_2": 3,
    "heritage_item": [
     "L5RCoreKat000054"
    ],
    "heritage_add_honor": -5,
    "heritage_add_glory": 0,
    "heritage_add_status": 0,
    "skill": "none"
   },
   "step19": {
    "firstname": "Ota"
   },
   "step20": {
    "death": "Ota hopes that his death is fated before he is forced into doing something irreversible and terrible on behalf of his lord."
   },
